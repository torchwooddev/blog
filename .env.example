# =============================================================================
# Torchwood Blog — 环境变量模板
# 复制为 .env 并填入真实值；.env 不进 git。
# =============================================================================

# --- 服务端专用（Server 函数 / server route 读取；绝不进入客户端 bundle）---
# Torchwood HTTP 端点（grpc-gateway）
BLOG_TORCHWOOD_ENDPOINT=http://localhost:9080
# 项目 ID（请求头 X-Torchwood-Project）
BLOG_TORCHWOOD_PROJECT_ID=blog
# Server API Key（Console → API Keys 创建；scope 需含 databases 读写）
BLOG_TORCHWOOD_API_KEY=
# 首次启动时灌种子数据（3 分类 / 8 文章（含 2 篇草稿）/ 6 标签 / 6 评论）
BLOG_SEED=true

# --- 公开（客户端 bundle 可见，VITE_ 前缀）---
# 浏览器直连 Torchwood Client API 用的端点与项目
VITE_TORCHWOOD_ENDPOINT=http://localhost:9080
VITE_TORCHWOOD_PROJECT_ID=blog
# 站点信息（title / OG / RSS / sitemap 的绝对地址）
VITE_SITE_NAME=Torchwood Blog
VITE_SITE_URL=http://localhost:3000
